# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Aiven Cloud MySQL Configuration
# (Found in your Aiven Console under Service Overview > Connection Details)
DB_HOST=your-aiven-mysql-host.aivencloud.com
DB_PORT=your-aiven-port
DB_USER=avnadmin
DB_PASSWORD=your_aiven_password
DB_NAME=rsu_vpass
# Set to true for Aiven SSL requirement. If you download Aiven CA cert, you can specify its path.
DB_SSL=true

# JWT Secret for Session & Tokens
JWT_SECRET=rsu_vpass_super_secret_jwt_token_2026_romblon
JWT_EXPIRES_IN=7d

# Cloudinary Configuration (For Driver's License, OR/CR & Photo Uploads on Render)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
