# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# TiDB Cloud MySQL Configuration (Serverless Free Tier)
# (Found in your TiDB Cloud Console under Connect > General / Node.js)
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=your_cluster_prefix.root
DB_PASSWORD=your_tidb_password_here
DB_NAME=rsu_vpass
DB_SSL=true

# JWT Secret for Session & Tokens
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Cloudinary Configuration (Optional for Cloud Image Storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Brevo (Sendinblue) Email Notification Service (300 Free Emails / Day)
# Get your free API key at: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
EMAIL_FROM=your_verified_sender_email@gmail.com
EMAIL_FROM_NAME="RSU VPASS (PASO)"
